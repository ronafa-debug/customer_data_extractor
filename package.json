{
  "name": "ecommerce-automation-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "전자상거래 업무 자동화 툴 (Order Extractor + Product Capture)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
